{
  "name": "jsgit-ssh",
  "version": "0.1.2",
  "description": "An SSH transport for isomorphic-git: an http-client shim that speaks git-upload-pack/git-receive-pack over an ssh2 exec channel, so git.clone/fetch/push/listServerRefs work over SSH in pure JS",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "src/"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "isomorphic-git",
    "isomorphic-git-ssh",
    "git",
    "ssh",
    "ssh transport",
    "git over ssh",
    "transport",
    "http-client",
    "http shim",
    "ssh2",
    "clone",
    "push",
    "fetch",
    "pull",
    "remote",
    "scp",
    "upload-pack",
    "receive-pack",
    "pure js",
    "node"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigsegv0x0b/jsgit-ssh.git"
  },
  "homepage": "https://github.com/sigsegv0x0b/jsgit-ssh#readme",
  "bugs": {
    "url": "https://github.com/sigsegv0x0b/jsgit-ssh/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "isomorphic-git": ">=1.24.0"
  }
}
